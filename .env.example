# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# disabled | sandbox | staging | live
# sandbox: Stripe test only, no Hostaway writes. staging: Stripe test plus one allowlisted Hostaway listing.
BOOKING_WRITE_MODE=disabled
# Explicitly opt into the local Stripe test checkout. Never enable with live keys.
ALLOW_SANDBOX_CHECKOUT=false
BOOKING_STAGING_LISTING_ID=

# Hostaway
HOSTAWAY_CLIENT_ID=
HOSTAWAY_CLIENT_SECRET=
HOSTAWAY_ACCESS_TOKEN=
HOSTAWAY_WEBHOOK_SECRET=
# Optional Hostaway Basic Auth credentials for conversation-message webhooks.
HOSTAWAY_WEBHOOK_LOGIN=
HOSTAWAY_WEBHOOK_PASSWORD=
# Hostaway sends the initial transactional SMS from its messaging provider.
# Set false as an emergency kill switch after launch.
HOSTAWAY_SMS_ENABLED=true
# Optional; defaults to five attempts per phone or browser IP per hour.
TEXT_INQUIRY_RATE_LIMIT=5
# Set to a long random secret in every deployed environment.
TEXT_INQUIRY_HASH_SALT=
# Existing Hostaway booking-engine domain used for direct-booking markup and fees
HOSTAWAY_BOOKING_ENGINE_DOMAIN=book.enchantedhavens.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Persistence
POSTGRES_URL=

# Email
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=stays@enchantedhavens.com
# Optional. Defaults to Enchanted Havens <GMAIL_USER>.
BOOKING_FROM_EMAIL=
# Replies to guest confirmations return here.
BOOKING_REPLY_TO_EMAIL=stays@enchantedhavens.com
